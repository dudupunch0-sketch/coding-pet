# Copy this file to ~/.config/coding-pet/service.env on the target server
# and adjust paths before enabling the systemd user services.

# Absolute path to the source checkout on the target server.
CODING_PET_REPO=/home/your-user/company/coding-pet/coding-pet

# Absolute path to the Python interpreter that has coding-pet installed.
# For source checkouts this is usually the repo-local virtualenv Python.
CODING_PET_PYTHON=/home/your-user/company/coding-pet/coding-pet/.venv/bin/python

# Optional: override sprite/theme asset location. Leave unset to use the
# checked-in assets from CODING_PET_REPO or installed share/coding-pet assets.
# CODING_PET_ASSETS_DIR=/home/your-user/company/coding-pet/coding-pet/assets/sprites

# Optional: use a Codex-style pet package copied from petdex/codex-pets.
# Expected package layout: $CODING_PET_CODEX_PETS_DIR/<pet-id>/pet.json
# and spritesheet.webp or spritesheet.png referenced by that manifest.
# CODING_PET_CODEX_PETS_DIR=/home/your-user/.codex/pets
# CODING_PET_THEME=<pet-id>
# You can set these after validation with:
# coding-pet admin set-pet <pet-id>

# Optional runtime path overrides for restricted company servers.
# Replace the placeholder paths with values approved for the target server.
# CODING_PET_CONFIG_DIR=/home/your-user/.config/coding-pet
# CODING_PET_STATE_DIR=/home/your-user/.local/state/coding-pet
# CODING_PET_RUNTIME_DIR=/run/user/UID/coding-pet  # final runtime directory
# CODING_PET_STATE_FILE=/home/your-user/.local/state/coding-pet/state.json
# CODING_PET_LOG_DIR=/home/your-user/.local/state/coding-pet/logs

# Optional: enable tmux polling for already-running Claude Code/OpenCode panes.
# Codex is also recognized for local development, but is not required on the
# company server.
# CODING_PET_TMUX_ENABLED=1

# Optional: keep inactive completed pets visible for this many seconds before
# the daemon removes them from the widget. Live sessions are not removed by this
# retention timer.
# CODING_PET_SHOW_COMPLETED_FOR_SEC=20

# Optional: seconds to wait after asking a daemon-owned backend process to stop
# before sending a kill fallback during daemon shutdown or explicit stop.
# CODING_PET_PROCESS_STOP_TIMEOUT_SEC=2

# Optional: transcript storage. Keep redaction enabled for target evidence.
# CODING_PET_TRANSCRIPT_ENABLED=1
# CODING_PET_TRANSCRIPT_DB=/home/your-user/.local/state/coding-pet/transcripts.sqlite
# CODING_PET_TRANSCRIPT_REDACT_SECRETS=1
# Optional: add company-specific regexes to redact from transcripts and evidence
# tails. Separate multiple patterns with semicolons or newlines.
# CODING_PET_TRANSCRIPT_REDACTION_PATTERNS=PROJECT-[0-9]{4};INTERNAL_SECRET_[A-Z]+

# Optional: override adapter control text if the installed Claude Code/OpenCode
# versions require different approval/rejection input during target validation.
# Leave these unset unless disposable-workspace validation proves a different
# value is needed.
# CODING_PET_CLAUDE_CODE_APPROVE_TEXT=approve
# CODING_PET_CLAUDE_CODE_REJECT_TEXT=reject
# CODING_PET_OPENCODE_APPROVE_TEXT=approve
# CODING_PET_OPENCODE_REJECT_TEXT=reject
