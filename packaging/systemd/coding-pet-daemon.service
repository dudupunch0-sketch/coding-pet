[Unit]
Description=Coding Pet daemon
After=network.target
PartOf=coding-pet.target

[Service]
Type=simple
Environment=PYTHONUNBUFFERED=1
Environment=CODING_PET_REPO=%h/company/coding-pet/coding-pet
Environment=CODING_PET_PYTHON=%h/company/coding-pet/coding-pet/.venv/bin/python
EnvironmentFile=-%h/.config/coding-pet/service.env
ExecStart=/usr/bin/bash -c 'cd "$CODING_PET_REPO" && export PYTHONPATH="$CODING_PET_REPO/src${PYTHONPATH:+:$PYTHONPATH}" && exec "$CODING_PET_PYTHON" -m coding_pet.cli daemon run'
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
